# Settings of the Lucid service (lucid.service), one LUCID_*=value per line.
# All settings are in the configuration table of the README:
# https://github.com/tbckr/lucid#configuration
# Apply changes with `systemctl restart lucid`.
#
# To let Lucid serve TLS itself, use the drop-in from the README instead of
# setting LUCID_TLS_CERT / LUCID_TLS_KEY here: the service runs as a dynamic
# user that cannot read the key files, so systemd passes them as credentials.

# Server mode, on the loopback interface for a reverse proxy on this machine
# (TLS is mandatory in server mode).
LUCID_ADDR=127.0.0.1:8080

# The reverse proxy sets X-Forwarded-For; trust it for the client IP. Remove
# this line if nothing sits in front of Lucid.
LUCID_TRUST_PROXY_HEADERS=true

# A separate listener for Prometheus metrics (/metrics).
#LUCID_METRICS_ADDR=127.0.0.1:9090

# CalDAV servers in internal networks (none by default in server mode).
#LUCID_PRIVATE_NETWORKS=192.168.1.10/32

#LUCID_LOG_LEVEL=info
