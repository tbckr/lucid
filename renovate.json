{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(deps)",
    ":separateMajorReleases",
    ":prConcurrentLimit10",
    ":timezone(Europe/Berlin)"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Go modules: group non-major updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "Frontend: group non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "frontend (non-major)"
    },
    {
      "description": "GitHub Actions: group non-major updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Container base image digests",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "container base image"
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions pinned in workflows (e.g. golangci-lint, goreleaser)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+[A-Za-z0-9_]+\\s*(?::|\\?=|:=|=)\\s*[\"']?(?<currentValue>[\\w.+-]+)[\"']?"
      ]
    }
  ]
}
